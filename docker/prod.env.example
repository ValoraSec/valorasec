# ValoraSec Production Environment Variables
# Copy this file to docker/prod.env and fill in your values.
# Never commit prod.env to version control.

# ─── Domain ──────────────────────────────────────────────────────────────
# The public domain name for your ValoraSec instance.
# Caddy will automatically provision SSL via Let's Encrypt.
CADDY_DOMAIN=valorasec.example.com

# ─── PostgreSQL ──────────────────────────────────────────────────────────
# Use strong, randomly generated passwords. Generate with:
#   openssl rand -base64 32
POSTGRES_USER=valorasec_prod
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=valorasec

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-strong-random-password

# ─── JWT ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_MS=604800000

# ─── Stellar / Soroban ──────────────────────────────────────────────────
STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=https://soroban.stellar.org

# ─── Contract Addresses (Deployed) ──────────────────────────────────────
# Fill in after deploying contracts to the network
AUDIT_REGISTRY_CONTRACT=
REPUTATION_CONTRACT=
BUG_BOUNTY_CONTRACT=

# ─── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGIN=https://valorasec.example.com

# ─── Web ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://valorasec.example.com/api
